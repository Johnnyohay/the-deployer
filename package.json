{
  "name": "the-deployer",
  "version": "0.1.0",
  "private": true,
  "description": "Turn plain-English interests into a self-updating briefing site: daily brief, topic desks, data, videos and Ask. ANU's engine, for any topic.",
  "type": "module",
  "scripts": {
    "deployer": "tsx src/cli.ts",
    "collect": "tsx src/cli.ts collect",
    "housing": "tsx src/cli.ts housing",
    "housing:coords": "tsx src/cli.ts housing-coords",
    "videos": "tsx src/cli.ts videos",
    "build:api": "tsx src/cli.ts build-api",
    "enrich": "tsx src/cli.ts enrich",
    "kb": "tsx src/cli.ts kb",
    "ask": "tsx src/cli.ts ask",
    "daily:claude": "tsx src/cli.ts daily-claude",
    "app": "vite build && tsx src/cli.ts serve",
    "app:dev": "tsx src/cli.ts serve & vite",
    "build:pages": "tsx src/build-pages.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p app",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@huggingface/transformers": "^4.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-xml-parser": "^5.11.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "vite": "^8.3.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "bin": {
    "deployer": "bin/deployer.mjs"
  }
}
